{
  "name": "@evan-coder/setupr",
  "version": "2.0.2",
  "description": "Terminal dashboard for unfamiliar projects. Detect stack, env, scripts, health, and next setup steps.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Evan1108-Coder/setupr.git"
  },
  "bugs": {
    "url": "https://github.com/Evan1108-Coder/setupr/issues"
  },
  "homepage": "https://github.com/Evan1108-Coder/setupr#readme",
  "bin": {
    "setupr": "dist/setup.js",
    "setup": "dist/setup.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/setup.js",
    "README.md",
    "SETUP.md",
    "ENVREADME.md",
    "TROUBLESHOOTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs/*.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "start": "node dist/setup.js",
    "smoke:fixtures": "npm run build && node scripts/smoke-fixtures.mjs",
    "smoke:fixtures:tui": "npm run build && node scripts/smoke-fixtures.mjs --tui",
    "fixtures:create": "node scripts/create-test-projects.mjs",
    "smoke:chaos": "npm run build && node scripts/smoke-chaos.mjs",
    "smoke:package": "npm run build && node scripts/smoke-package.mjs"
  },
  "keywords": [
    "project-setup",
    "cli",
    "cli-tool",
    "developer-tools",
    "devtools",
    "ai",
    "tui",
    "terminal-dashboard",
    "project-health",
    "project-onboarding",
    "local-dev",
    "env-check",
    "setup-doctor",
    "environment",
    "dependencies",
    "automation"
  ],
  "author": "Evan Lu",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "ansi-escapes": "^7.0.0",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "cli-cursor": "^5.0.0",
    "figures": "^6.1.0",
    "glob": "^13.0.6",
    "ink": "5.2.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "^15.0.12",
    "meow": "^13.2.0",
    "minimatch": "^10.2.6",
    "openai": "^4.78.0",
    "ora": "^8.1.1",
    "react": "^18.3.1",
    "string-width": "^7.2.0",
    "strip-ansi": "^7.1.0",
    "yaml": "^2.7.1",
    "zustand": "^5.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.15.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.11"
  }
}
